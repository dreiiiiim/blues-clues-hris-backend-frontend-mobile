# =============================================================================
# Environment Variable Reference — Sensitivity Classification
# =============================================================================
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# Store HIGH-sensitivity values in GitHub Secrets / Vault / your cloud
# provider's secret manager — not in plaintext files on developer machines.
#
# Sensitivity levels used here:
#   LOW    — safe to log, share in tickets, or store unencrypted in CI env vars
#   MEDIUM — treat like a password: do not log, rotate on breach
#   HIGH   — treat like a private key: store in Vault/Secrets Manager
#
# =============================================================================

# -----------------------------------------------------------------------------
# Service identity
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
ENABLE_SWAGGER=false

# -----------------------------------------------------------------------------
# Supabase
#   SUPABASE_URL              — LOW
#   SUPABASE_ANON_KEY         — MEDIUM (RLS applies, safe server-side)
#   SUPABASE_SERVICE_ROLE_KEY — HIGH (bypasses RLS; store in Vault)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -----------------------------------------------------------------------------
# Auth
#   JWT_SECRET — HIGH (used to sign JWT tokens for all sessions)
# -----------------------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-string

# -----------------------------------------------------------------------------
# CORS
#   ALLOWED_ORIGINS — LOW; comma-separated, exact-match (no wildcards)
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# APICenter integration (required in production lanes for checks.apiCenter=true)
#   API_CENTER_BASE_URL     — LOW   (alias: APICENTER_BASE_URL)
#   API_CENTER_TRIBE_ID     — MEDIUM (alias: APICENTER_TRIBE_ID)
#   API_CENTER_TRIBE_SECRET — HIGH   (alias: APICENTER_TRIBE_SECRET)
#   API_CENTER_API_KEY      — HIGH   (legacy fallback)
#   API_CENTER_TIMEOUT_MS   — LOW    (default 10000)
# -----------------------------------------------------------------------------
API_CENTER_BASE_URL=https://api-center.example.com
API_CENTER_TRIBE_ID=your-tribe-service-id
API_CENTER_TRIBE_SECRET=your-tribe-secret-here
API_CENTER_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# Tribe self-registration (used by TribeRegistrationService on bootstrap)
# -----------------------------------------------------------------------------
TRIBE_SERVICE_ID=tribex-hris-auth
TRIBE_NAME=TribeX HRIS Authentication API
TRIBE_BASE_URL=http://localhost:5000
PLATFORM_ADMIN_SECRET=change-me-in-production

# =============================================================================
# Render deployment notes
# =============================================================================
# For Render deployments, configure runtime variables in Render Environment
# settings (do NOT commit a production .env). In production lanes, APICenter
# values are required so health verification can pass with checks.apiCenter=true.
#
# CI workflow Render secrets:
#   RENDER_DEPLOY_HOOK_URL_TEST / UAT / MAIN
#   RENDER_HEALTHCHECK_URL_TEST / UAT / MAIN
#   Optional fallback: RENDER_DEPLOY_HOOK_URL, RENDER_HEALTHCHECK_URL
# =============================================================================
