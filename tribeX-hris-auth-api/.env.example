# ─── Setup ────────────────────────────────────────────────────────────────────
# 1. Copy this file:  cp .env.example .env
# 2. Fill in all values. Real values for this project are in the team GDocs —
#    see the link at the top of README.md. Never commit .env with real secrets.
# ──────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5000
ENABLE_SWAGGER=true

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get from: Supabase dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-64-char-hex-secret

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Subscription / PayMongo ──────────────────────────────────────────────────
# Shared secret for confirming PayMongo payments on the /payment/confirm endpoint.
# Must exactly match NEXT_PUBLIC_SUBSCRIPTION_WEBHOOK_SECRET in the frontend .env.local.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SUBSCRIPTION_WEBHOOK_SECRET=your-64-char-hex-secret

# ─── API Center ───────────────────────────────────────────────────────────────
# Tribe credentials for API Center integration. Get values from team GDocs.
APICENTER_BASE_URL=https://api-center-test.itsandbox.site
APICENTER_TRIBE_ID=your-tribe-id
APICENTER_TRIBE_SECRET=your-tribe-secret

# ─── App ──────────────────────────────────────────────────────────────────────
# Frontend URL used in email verification and password-reset links.
APP_URL=http://localhost:3000
