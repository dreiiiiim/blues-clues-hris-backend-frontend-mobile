# Copy this file to .env.local and fill in the values.

# Local dev (backend running on your machine):
# NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1

# Production (Railway backend):
NEXT_PUBLIC_API_BASE_URL=https://blues-clues-hris-backend-frontend-mobile-production.up.railway.app/api/tribeX/auth/v1

# Shared secret for confirming PayMongo payments.
# Must match SUBSCRIPTION_WEBHOOK_SECRET in the backend .env.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXT_PUBLIC_SUBSCRIPTION_WEBHOOK_SECRET=your-64-char-hex-secret-here
